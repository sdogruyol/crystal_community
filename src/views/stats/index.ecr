<%
  canonical_url = request_url
  og_url = request_url
  og_title = page_title
  og_description = page_description
  twitter_url = request_url
  twitter_title = page_title
  twitter_description = page_description
%>

<section class="hero" aria-labelledby="stats-heading">
  <h1 id="stats-heading">Crystal on GitHub</h1>
  <p class="hero-join-text">
    Public repository metrics from the GitHub Search API (non-fork Crystal repos). Values refresh when the stats job runs; the 30-day window is UTC from each snapshot time.
  </p>
</section>

<section class="developers" aria-label="GitHub ecosystem statistics">
  <% if gs = github_stat %>
    <ul class="developer-list" style="list-style: none;">
      <li class="developer-card">
        <h2 class="visually-hidden">Latest snapshot</h2>
        <div class="developer-stats">
          <div class="stat-item">
            <span class="stat-value"><%= gs.repos_scanned %></span>
            <span>Crystal repos</span>
          </div>
          <div class="stat-item">
            <span class="stat-value"><%= gs.unique_owners %></span>
            <span>Unique owners (bots excluded)</span>
          </div>
          <div class="stat-item">
            <span class="stat-value"><%= gs.repos_pushed_last_30d %></span>
            <span>Pushed in last 30 days</span>
          </div>
          <div class="stat-item">
            <span class="stat-value"><%= gs.repos_created_last_30d %></span>
            <span>Created in last 30 days</span>
          </div>
          <div class="stat-item">
            <span class="stat-value"><%= gs.total_stars %></span>
            <span>Total stars (sum)</span>
          </div>
          <div class="stat-item">
            <span class="stat-value"><%= gs.repos_owner_user %></span>
            <span>Repos — user owners</span>
          </div>
          <div class="stat-item">
            <span class="stat-value"><%= gs.repos_owner_org %></span>
            <span>Repos — organizations</span>
          </div>
        </div>

        <h3 class="stats-subheading">Star distribution</h3>
        <% star_buckets = [
          {"0", gs.stars_bucket_0},
          {"1–10", gs.stars_bucket_1_10},
          {"11–100", gs.stars_bucket_11_100},
          {"101–1000", gs.stars_bucket_101_1000},
          {"1001+", gs.stars_bucket_1001_plus},
        ] %>
        <% star_max = star_buckets.max_of? { |(_, c)| c } || 1 %>
        <ul class="stats-bar-list" aria-label="Repositories by star count">
          <% star_buckets.each do |(label, count)| %>
            <li class="stats-bar-row">
              <span class="stats-bar-label"><%= label %> stars</span>
              <div class="stats-bar-track" role="presentation">
                <div class="stats-bar-fill" style="width: <%= star_max > 0 ? (100.0 * count / star_max).round(1) : 0 %>%;"></div>
              </div>
              <span class="stats-bar-count"><%= count %></span>
            </li>
          <% end %>
        </ul>

        <h3 class="stats-subheading">Top topics</h3>
        <% if gs.top_topics.empty? %>
          <p class="stats-muted">No topics in this snapshot.</p>
        <% else %>
          <ol class="stats-topics-list">
            <% gs.top_topics.each do |(topic, count)| %>
              <li><span class="stats-topic-name"><%= HTML.escape(topic) %></span> <span class="stats-topic-count"><%= count %></span></li>
            <% end %>
          </ol>
        <% end %>

        <p class="stats-meta" style="margin-top: 1.25rem; color: var(--text-secondary); font-size: 0.9rem;">
          30-day window starts <strong><%= gs.since.to_utc.to_s("%Y-%m-%d") %></strong> UTC (rolling at collection time).
          Last collected <strong><%= gs.collected_at.to_utc.to_s("%Y-%m-%d") %></strong>
          <span class="stats-meta-time"><%= gs.collected_at.to_utc.to_s("%H:%M:%S") %> UTC</span>.
        </p>
      </li>
    </ul>

    <section class="developer-card stats-timeseries" aria-labelledby="timeseries-heading">
      <h2 id="timeseries-heading" class="stats-subheading">History (last <%= github_stat_series.size %> runs)</h2>
      <% if github_stat_series.size < 2 %>
        <p class="stats-muted">Run the stats job at least twice to see trend lines.</p>
      <% else %>
        <p class="stats-chart-legend">
          <span class="stats-legend-item"><span class="stats-legend-swatch stats-legend-repos"></span> Repos</span>
          <span class="stats-legend-item"><span class="stats-legend-swatch stats-legend-pushed"></span> Pushed 30d</span>
          <span class="stats-legend-item"><span class="stats-legend-swatch stats-legend-created"></span> Created 30d</span>
          <span class="stats-legend-item"><span class="stats-legend-swatch stats-legend-stars"></span> Total stars</span>
        </p>
        <p class="stats-muted stats-chart-note">Each line is scaled to its own maximum in this window (normalized), so you can compare shape, not absolute scale across metrics.</p>
        <svg class="stats-chart-svg" viewBox="0 0 1000 220" preserveAspectRatio="none" role="img" aria-label="Normalized trends for repos, 30-day activity, and total stars">
          <g fill="none" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round">
            <% unless chart_line_repos.empty? %>
              <polyline class="stats-line-repos" points="<%= chart_line_repos %>" />
            <% end %>
            <% unless chart_line_pushed.empty? %>
              <polyline class="stats-line-pushed" points="<%= chart_line_pushed %>" />
            <% end %>
            <% unless chart_line_created.empty? %>
              <polyline class="stats-line-created" points="<%= chart_line_created %>" />
            <% end %>
            <% unless chart_line_stars.empty? %>
              <polyline class="stats-line-stars" points="<%= chart_line_stars %>" />
            <% end %>
          </g>
        </svg>
      <% end %>

      <div class="stats-table-wrap">
        <table class="stats-history-table">
          <caption class="visually-hidden">Per-run metrics</caption>
          <thead>
            <tr>
              <th scope="col">Collected (UTC)</th>
              <th scope="col">Repos</th>
              <th scope="col">Pushed 30d</th>
              <th scope="col">Created 30d</th>
              <th scope="col">Total stars</th>
              <th scope="col">User / Org</th>
            </tr>
          </thead>
          <tbody>
            <% github_stat_series.reverse_each do |row| %>
              <tr>
                <td><%= row.collected_at.to_utc.to_s("%Y-%m-%d %H:%M") %></td>
                <td><%= row.repos_scanned %></td>
                <td><%= row.repos_pushed_last_30d %></td>
                <td><%= row.repos_created_last_30d %></td>
                <td><%= row.total_stars %></td>
                <td><%= row.repos_owner_user %> / <%= row.repos_owner_org %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% else %>
    <div class="developer-card empty-state" role="status">
      <p>No GitHub stats yet.</p>
    </div>
  <% end %>
</section>
